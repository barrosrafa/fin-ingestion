# Database Configuration (PostgreSQL 18 / TimescaleDB on Neon)
DATABASE_URL=postgresql://user:password@ep-cool-base-123456.us-east-2.aws.neon.tech/fin?sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@ep-cool-base-123456.us-east-2.aws.neon.tech/fin?sslmode=require

# Redis Configuration (Queue & Distributed Rate Limiting)
REDIS_URL=redis://localhost:6379/0
# Enable only after Redis readiness validation; required for multiple workers.
DISTRIBUTED_SOURCE_CONTROLS=false

# Ingestion Engine Settings
INGESTION_ENV=development
LOG_LEVEL=INFO
MAX_CONCURRENT_REQUESTS=10
DEFAULT_TIMEOUT_SECONDS=30
ENABLE_RAW_LANDING=true

# dbt Configuration
DBT_PROFILES_DIR=./dbt
DBT_PROJECT_DIR=./dbt
DBT_TARGET=dev

# Optional Provider Credentials / Tokens
CLUBE_FII_JWT_TOKEN=
STATUS_INVEST_COOKIE=
BRICK360_API_KEY=
