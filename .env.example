# Database Configuration (PostgreSQL 18 / TimescaleDB on Neon)
DATABASE_URL=postgresql://user:password@ep-cool-base-123456.us-east-2.aws.neon.tech/fin?sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@ep-cool-base-123456.us-east-2.aws.neon.tech/fin?sslmode=require

# Redis Configuration (Queue & Distributed Rate Limiting)
REDIS_URL=redis://localhost:6379/0
# Enable only after Redis readiness validation; required for multiple workers.
DISTRIBUTED_SOURCE_CONTROLS=false

# Ingestion Engine Settings
INGESTION_ENV=development
LOG_LEVEL=INFO
MAX_CONCURRENT_REQUESTS=10
DEFAULT_TIMEOUT_SECONDS=30
ENABLE_RAW_LANDING=true
# postgres remains the default; local stores exact bytes and SHA-256 audit captures.
RAW_LANDING_BACKEND=postgres
RAW_LANDING_DIR=./data/bronze

# dbt Configuration
DBT_PROFILES_DIR=./dbt
DBT_PROJECT_DIR=./dbt
DBT_TARGET=dev

# Optional Provider Credentials / Tokens
CLUBE_FII_JWT_TOKEN=
STATUS_INVEST_COOKIE=
BRICK360_API_KEY=

# Commercial providers: never put real credentials in this example file.
BRAPI_API_KEY=
MASSIVE_API_KEY=
FMP_API_KEY=
TWELVE_DATA_API_KEY=
ANBIMA_CLIENT_ID=
ANBIMA_CLIENT_SECRET=
# Atomic ceilings enforced in shared Redis; one credit is charged for every attempt.
PROVIDER_MONTHLY_CREDITS={"brapi":1000}
BRAPI_BATCH_SIZE=1
BRAPI_RAW_HISTORY=false
INTRADAY_ENABLED=false
INTRADAY_TICKERS=[]
INTRADAY_MAX_AGE_SECONDS=1200
# Empty means unfiltered legacy worker; use explicit lists for dedicated workers.
WORKER_DATASETS=[]
